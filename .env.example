# Clé API de ton application Xaman (https://apps.xumm.dev)
VITE_XAMAN_API_KEY=

# Adresse du marchand (commence par "r")
VITE_MERCHANT_ADDRESS=

# Réseau : testnet (argent fictif) ou mainnet (argent réel).
# Tout ce qui n'est pas exactement "mainnet" donne le testnet.
VITE_NETWORK=testnet

# Plafond par paiement. Vide = 1000 sur le testnet, 5 sur le réseau principal.
VITE_MAX_AMOUNT=

# Secret du compte marchand (commence par "s"). TESTNET SEULEMENT.
# Il sert une fois, pour "npm run trustline".
# Ne mets JAMAIS ici le secret d'un compte du réseau principal.
MERCHANT_SECRET=
